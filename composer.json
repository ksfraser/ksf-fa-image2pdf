    "type": "fa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "KS Fraser"
        }
    ],
    "repositories": [
        { "type": "vcs", "url": "git@github.com:ksfraser/ksf-image2pdf.git" },
        { "type": "vcs", "url": "git@github.com:ksfraser/ksf-ocr.git" }
    ],
    "require": {
        "php": ">=7.3",
        "ksfraser/ksf-image2pdf": "*",
        "ksfraser/ksf-ocr": "*"
